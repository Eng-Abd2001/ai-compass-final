# Public site URL (canonical, sitemap, Open Graph). On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Never put secrets in NEXT_PUBLIC_* variables. Server-only keys (future AI APIs, database) go in non-public variables.
# Shown on the Contact page. Leave empty until you have a real address.
NEXT_PUBLIC_CONTACT_EMAIL=
